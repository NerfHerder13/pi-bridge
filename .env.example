PI_BIN=/path/to/pi
GATEWAY_MENU=/path/to/gateway-menu.json
# Optional. The URL the gateway serves its menu at. install.sh refreshes GATEWAY_MENU from it.
GATEWAY_MENU_URL=
GATEWAY_KEY_FILE=/path/to/gateway-key
GATEWAY_CA_FILE=/path/to/gateway-ca.pem
GATEWAY_KEY_HEADER=
# Optional. The memory palace folder. Default: ~/memory-palace
MEMORY_PALACE_DIR=
